{
    "java.compile.nullAnalysis.mode": "automatic",
    "java.import.exclusions": [
        "ui/**"
    ],
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/node_modules/**": true,
        "**/target/**": true,
        "**/bin/**": true
    },
    "chat.tools.terminal.autoApprove": {
        "npm run build": true,
        "mvn -f api/pom.xml": true,
        "/^mvn -q -f api/pom\\.xml dependency:build-classpath -Dmdep\\.outputFile=/tmp/db4all-api\\.cp && echo ready$/": {
            "approve": true,
            "matchCommandLine": true
        }
    },
    "workbench.colorCustomizations": {
        "terminal.background": "#0C0C0C",
        "terminal.foreground": "#CCCCCC"
    }
    // NOTE: when the Dev Containers host is WSL-Ubuntu with rootless podman,
    // set these in your USER settings (application scope, workspace is ignored):
    //   "dev.containers.dockerPath": "/usr/bin/podman",
    //   "dev.containers.dockerSocketPath": "/run/user/1000/podman/podman.sock"
}
